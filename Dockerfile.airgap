# 취업규칙 검토 AI — 백엔드 airgap 이미지 (moellab.info/for-ceo 서버용).
# 관리자(streamlit 8502)는 관리자 기능 제외 결정으로 삭제 — API(uvicorn 8503)만 실행.
FROM python:3.14.7-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    LANG=C.UTF-8 \
    LC_ALL=C.UTF-8 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

# 1) 의존성 먼저 (레이어 캐시)
COPY backend/requirements-api.txt backend/requirements-airgap.txt /app/backend/
RUN pip install --no-cache-dir -r /app/backend/requirements-airgap.txt

# 2) 백엔드 코드
COPY backend /app/backend

# 3) 레포 루트의 Excel 마스터 DB (master_db.py 의 _REPO_ROOT = /app)
COPY ["취업규칙 마스터 db (2026).xlsx", "/app/취업규칙 마스터 db (2026).xlsx"]
COPY ["취업규칙 마스터 db.xlsx", "/app/취업규칙 마스터 db.xlsx"]

WORKDIR /app/backend

# 비-root 실행(OWASP A05 보안설정오류/컨테이너 하드닝).
# uid/gid 는 호스트 바인드마운트(./data, 소유 1000:1000)와 일치시켜 쓰기 가능하게 함.
RUN groupadd -g 1000 appuser \
    && useradd --create-home -u 1000 -g 1000 appuser \
    && mkdir -p /app/backend/data \
    && chown -R appuser:appuser /app
USER appuser

EXPOSE 8503
CMD ["python", "-m", "uvicorn", "cgr.api.main:app", "--host", "0.0.0.0", "--port", "8503"]
