# ═══════════════════════════════════════════════════════════════════
# for-ceo.v2 backend — 환경변수 스키마 문서
# ═══════════════════════════════════════════════════════════════════
# 사용법
#   1. 이 파일을 복사: cp .env.example .env
#   2. change-me 값들을 실제 값으로 교체
#   3. .env 는 반드시 gitignore (실제 값 커밋 금지)
# ═══════════════════════════════════════════════════════════════════

# ── 1) PostgreSQL 접속 (필수) ─────────────────────
# DB 는 외부에서 이미 프로비저닝 되어있음 (테이블 포함 사전 준비).
# DSN 형식: postgresql://user:password@host:port/dbname
# 비밀번호에 특수문자(@:/?#&)가 있으면 URL 인코딩 필요.
# 예: hello!@#) → hello%21%40%23%29
CGR_PG_DSN=postgresql://user:pw@host:port/dbname

# 커넥션 풀 정책
CGR_PG_TOTAL_MAX_CONN=50           # PG 서버 max_connections 이하 (모든 워커 합산 상한)
CGR_PG_POOL_MIN_PER_WORKER=1       # 워커당 유지 최소 커넥션
CGR_PG_RETRY_MAX_ATTEMPTS=3        # 일시 에러 재시도 횟수 (현재는 참고용)
CGR_PG_RETRY_DELAY_SECONDS=0.5     # 재시도 간 대기 초

# ── 2) 서버 (FastAPI · Uvicorn) ───────────────────
CGR_API_HOST=0.0.0.0
CGR_API_PORT=8503
CGR_API_ALLOWED_ORIGINS=http://localhost:3000
# uvicorn --workers 값과 반드시 동일하게 (DB 풀 계산에 사용)
UVICORN_WORKERS=1
# 프론트(BFF) ↔ FastAPI 인증 키
CGR_API_KEY=change-me-user-api-key
CGR_API_ADMIN_KEY=change-me-admin-api-key

# ── 3) LLM (OpenAI) ───────────────────────────────
OPENAI_API_KEY=sk-proj-change-me
OPENAI_MODEL=gpt-5.4-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-large
OPENAI_EMBEDDING_DIM=1024

# ── 4) 데이터 디렉토리 (파일 저장 경로) ───────────
CGR_DATA_DIR=./data                 # 업로드 파일·리포트 저장 루트
# CGR_UPLOADS_DIR=                  # 미지정 시 {CGR_DATA_DIR}/uploads

# ── 5) 동작 스위치 ────────────────────────────────
CGR_LOG_LEVEL=INFO                  # DEBUG | INFO | WARNING | ERROR
CGR_DISABLE_CACHE=false             # LLM 캐시 스위치 (테스트 격리 시 true)
CGR_PII_MASK=true                   # 외부 LLM 호출 전 PII 마스킹 (운영 항상 true)

# 로그 파일 저장 (선택 — 컨테이너 재시작 시 로그 유지)
# - 빈 값이면 stderr 만 (Docker 관리 로그로 충분)
# - 값 지정 시: stderr + 파일 dual write
# - 도커: docker-compose 볼륨과 짝 (./logs:/app/logs)
CGR_LOG_FILE=                       # 예: /app/logs/app.log
CGR_LOG_FILE_MAX_BYTES=20971520     # 20MB (파일 하나 상한)
CGR_LOG_FILE_BACKUP_COUNT=10        # 백업 파일 개수 (초과 시 오래된 것 자동 삭제)
