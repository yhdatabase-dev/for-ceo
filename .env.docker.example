# moellab.info 배포용 환경변수 템플릿.
#   cp .env.docker.example .env   후 아래 값을 채우세요. (.env 는 git 에 올리지 마세요)

# ── 도메인 ──
SITE_ADDRESS=moellab.info

# ── 백엔드 인증 키 (임의의 길고 강한 문자열) ──
#    아래 CGR_API_KEY / CGR_ADMIN_API_KEY 와 반드시 같은 값으로 맞추세요.
API_KEY=change-me-strong-key
ADMIN_API_KEY=change-me-strong-admin-key

# ── OpenAI (검토·챗봇 LLM 호출에 필요) ──
OPENAI_API_KEY=sk-여기에-본인-OpenAI-키
OPENAI_MODEL=gpt-5.4-mini

# ── PostgreSQL (DE10 스키마 ai · app) ──
PGHOST=db-host
PGPORT=5432
PGDATABASE=db-name
PGUSER=db-user
PGPASSWORD=db-password

# ── 프론트(BFF)가 백엔드 호출 시 붙이는 키 — 위 값과 동일하게 ──
CGR_API_KEY=change-me-strong-key
CGR_ADMIN_API_KEY=change-me-strong-admin-key

# ── 관리자 대시보드 로그인 ──
ADMIN_PASSWORD=원하는-관리자-비밀번호
ADMIN_SESSION_SECRET=bda7036bc54d5a8c9df71ec82b666e61c125d60ba3423f9d91e7ef48c2106d54
