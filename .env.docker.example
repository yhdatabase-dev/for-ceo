# 자체 서버(docker compose) 배포용 환경변수 템플릿.
#   cp .env.docker.example .env   후 아래 값을 채우세요. (.env 는 git 에 올리지 마세요)
#   항목 설명은 .env.example 과 같습니다.

# ── 도메인 ──
SITE_ADDRESS=moellab.info

# ── 서비스 키 (임의의 길고 강한 문자열) — 백엔드·프론트(BFF)가 같은 값을 씀 ──
CGR_API_KEY=change-me-strong-key

# ── OpenAI (운영은 키 필수 — 없으면 백엔드가 시작하지 않음) ──
OPENAI_API_KEY=
CGR_LLM_MODEL=gpt-5.4-mini

# ── PostgreSQL (스키마 ai · app) ──
CGR_DB_HOST=db-host
CGR_DB_PORT=5432
CGR_DB_NAME=db-name
CGR_DB_USER=db-user
CGR_DB_PASSWORD=db-password
