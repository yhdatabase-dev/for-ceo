#
# 근로계약서·취업규칙 검토(CGR) 환경변수
#
# 사용: 이 파일을 같은 폴더에 .env 로 복사한 뒤 값을 채운다. .env 는 git 에 올리지 않는다.
# 읽는 곳: 백엔드 = backend/app/core/config.py 한 곳 / 프론트 = Next.js 서버 측(next.config.mjs 가 로드)
# 우선순위: 실제 환경변수 > .env (운영·컨테이너는 환경변수로만 주입한다)
#



# ======================================================================
# 공통
# ======================================================================

# ── 로컬 실행 포트 ── 다른 프로젝트(산업안전보건 18080/18090)와 겹치지 않게 18081/18091 을 쓴다
CGR_BACKEND_PORT=18081
CGR_FRONTEND_PORT=18091

# ── 실행 환경 ── local | dev | prod
CGR_ENVIRONMENT=local
# DEBUG | INFO | WARNING | ERROR
CGR_LOG_LEVEL=INFO

# ── DB (개발서버 PostgreSQL 16, 스키마 ai · app) ──
CGR_DB_HOST=
CGR_DB_PORT=
CGR_DB_NAME=
CGR_DB_USER=
CGR_DB_PASSWORD=



# ======================================================================
# 웹 · 백엔드
# ======================================================================

# ── 인증 ── 프론트 서버(BFF)만 아는 서비스 키. 브라우저에 노출되지 않는다. 백엔드·프론트가 같은 값을 쓴다
CGR_API_KEY=

# ── CORS 허용 출처(쉼표 구분) ── 비우면 http://localhost:<CGR_FRONTEND_PORT>
CGR_ALLOWED_ORIGINS=

# ── 데이터 · 업로드 ── 비우면 backend/data, backend/data/uploads
CGR_DATA_DIR=
CGR_UPLOADS_DIR=
CGR_PROMPTS_DIR=
CGR_MAX_UPLOAD_MB=20



# ======================================================================
# 웹 · 프론트엔드 (Next.js 서버 측)
# ======================================================================

# 프론트 서버가 백엔드를 부르는 주소(브라우저는 이 주소를 모른다)
CGR_API_BASE=http://localhost:18081
# 하위 경로 배포 시 접두어(예: /cgr). 로컬은 빈 값
NEXT_PUBLIC_BASE_PATH=



# ======================================================================
# AI (LLM 호출)
# ======================================================================

# ── LLM ── 키가 비어 있으면 내장 가짜 LLM(mock)으로 동작한다. 로컬·테스트는 실호출하지 않는다
#            운영(CGR_ENVIRONMENT=prod)에서 키가 없으면 시작하지 않는다
OPENAI_API_KEY=
# 키가 있어도 가짜 LLM 으로 돌릴 때 1
CGR_LLM_MOCK=0
# OpenAI 호환 서버를 쓸 때만 지정(비우면 OpenAI)
OPENAI_BASE_URL=

# ── 용도별 모델 ──
CGR_LLM_MODEL=gpt-5.4-mini
CGR_EMBED_MODEL=text-embedding-3-large
CGR_EMBED_DIM=1024

# ── LLM 응답 캐시 ── 1 이면 끈다(같은 입력도 매번 호출)
CGR_DISABLE_CACHE=0

# ── 취업규칙 마스터 DB 파일 경로 ── 비우면 기본 위치
MASTER_DB_PATH=
